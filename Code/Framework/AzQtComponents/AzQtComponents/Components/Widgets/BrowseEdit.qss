AzQtComponents--BrowseEdit
{
    margin: $SpacingControlMargin;
}

AzQtComponents--BrowseEdit QLineEdit
{
    height: $SizeInputHeight;
    border-width: 0px;
    border-style: solid;
    border-color: transparent;
    border-top-left-radius: $RadiusInput;
    border-bottom-left-radius: $RadiusInput;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
    /* T R B L; left 2 (2px already applied), right -4 (14px default applied: 14-4=10) */
    padding: $SpacingBrowseEditPad;
}

AzQtComponents--BrowseEdit.ValidDropTarget QLineEdit,
AzQtComponents--BrowseEdit.ValidDropTarget QLineEdit:focus,
AzQtComponents--BrowseEdit.ValidDropTarget QLineEdit:hover
{
    background-color: transparent;
}

AzQtComponents--BrowseEdit.InvalidDropTarget QLineEdit,
AzQtComponents--BrowseEdit QLineEdit:focus
{
    background-color: $InputFocusBackgroundColor;
    border-color: $BrowseEditFocusBorderColor;
}

AzQtComponents--BrowseEdit QLineEdit:disabled
{
    border-color: $BrowseEditDisabledBorderColor;
}

AzQtComponents--BrowseEdit #attached-button
{
    /* Set the flat property to true to enable QPushButton styling from QSS */
    qproperty-flat: true;

    max-width: $SizeGlyph;
    min-width: $SizeGlyph;
    max-height: $SizeGlyph;
    min-height: $SizeGlyph;

    qproperty-iconSize: $SizeGlyphTiny $SizeGlyphTiny;

    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 $BrowseEditButtonGradientTop, stop: 1 $BrowseEditButtonGradientBottom);

    border-width: 0px;
    border-style: solid;
    border-left: none;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: $RadiusInput;
    border-bottom-right-radius: $RadiusInput;
}

AzQtComponents--BrowseEdit #attached-button:hover
{
    background-color: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                      stop: 0 $BrowseEditButtonHoverGradientTop, stop: 1 $BrowseEditButtonGradientTop);
}

AzQtComponents--BrowseEdit #attached-button:pressed
{
    background-color: $BackgroundColor;
}

AzQtComponents--BrowseEdit #attached-button:disabled
{
    background-color: $InputDisabledBackgroundColor;
    border-left: $BorderThin solid $BrowseEditButtonGradientBottom;
}
