QMenuBar
{
    min-height: $SizeMenuBarHeight;
    height: $SizeMenuBarHeight;
    font-family: "$AmazonEmberFontFamily";
    font-size: $FontSize;
    margin: 0px;
    spacing: 0px;
    border-bottom-width: $BorderDivider;
    border-bottom-color: $SeparatorColor;
    border-bottom-style: solid;
}

QMenuBar::item
{
    padding-left: $SpacingMenuBarItemH;
    padding-right: $SpacingMenuBarItemH;
}

QMenuBar::item:selected
{
    background-color: $MenuBarItemSelectedBackgroundColor;
}

QMenuBar::item:pressed
{
    background-color: $MenuBackgroundColor;
}
