AzQtComponents--SegmentBar
{
    margin-bottom: $SpacingSegmentMarginBottom;
}

AzQtComponents--SegmentBar QAbstractButton
{
    background-color: $SegmentControlButtonColor;
    border-color: $MenuBackgroundColor;
    border-style: solid;
    border-width: $BorderControl;

    font-size: $FontSize;

    height: $SizeSegmentHeight;

    line-height: $LineHeightTall;

    margin-left: 0px;

    min-width: $SizeSegmentMinWidth; /* 100 - (padding-left + padding-right) */

    padding-left: $SpacingSegmentH;
    padding-right: $SpacingSegmentH;
}

AzQtComponents--SegmentBar[orientation="1"] QAbstractButton.TabLast
{
    margin-left: $SpacingSegmentOverlap;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
    border-top-right-radius: $RadiusSegment;
    border-bottom-right-radius: $RadiusSegment;
}

AzQtComponents--SegmentBar[orientation="1"] QAbstractButton.TabFirst
{
    border-top-left-radius: $RadiusSegment;
    border-bottom-left-radius: $RadiusSegment;
    border-top-right-radius: 0px;
    border-bottom-right-radius: 0px;
}

AzQtComponents--SegmentBar[orientation="1"] QAbstractButton.TabMiddle
{
    margin-left: $SpacingSegmentOverlap;
}

AzQtComponents--SegmentBar[orientation="2"] QAbstractButton
{
    text-align: left;
}

AzQtComponents--SegmentBar[orientation="2"] QAbstractButton.TabMiddle,
AzQtComponents--SegmentBar[orientation="2"] QAbstractButton.TabLast
{
    margin-top: $SpacingSegmentOverlap;
}

AzQtComponents--SegmentBar QAbstractButton:checked
{
    background-color: $MenuBarItemSelectedBackgroundColor;
}

AzQtComponents--SegmentBar QAbstractButton:hover:!checked,
AzQtComponents--SegmentBar QAbstractButton:pressed:!checked
{
    background-color: $BackgroundColor;
}
