/* Override transparent background colour for default QTabWidgets */
QTabWidget,
QTabBar
{
    background-color: $BackgroundColor;
}

QTabBar::tab
{
    max-width: $SizeTabMaxWidth;
}

AzQtComponents--TabWidget
{
    background-color: $SeparatorColor;
}

AzQtComponents--TabWidget > QWidget
{
    background-color: $BackgroundColor;
}

AzQtComponents--TabWidget:pane
{
    border: 0 none;
}

AzQtComponents--TabWidget.Empty:pane
{
    margin-top: $SpacingTabEmptyPaneMarginTop;
}

AzQtComponents--TabBar
{
    qproperty-drawBase: false; /* Stop the base being visible during tab position change animation */
    background-color: $SeparatorColor;
    margin-bottom: 0;
    min-height: $SizeTabBarHeight;
}

AzQtComponents--TabBar:tab
{
    border: $BorderThin solid $SeparatorColor;
    background-color: $TabWidgetInactiveTabColor;

    text-align: left;
    /* top right bottom left (Vector4) -- right padding reserves room for the close (X) button so it no
       longer overlaps the tab text (was -2px). */
    padding: $SpacingTabPadding;
}

/* Keep the close (X) button clear of the label and the tab's right edge. */
AzQtComponents--TabBar::close-button
{
    subcontrol-position: right;
    margin-left: $SpacingTabCloseGap;
}

AzQtComponents--TabBar::tab:text
{
    font-size: $FontSize;
    line-height: $LineHeightTall;
}

AzQtComponents--TabBar::tab:selected
{
    border-bottom: $BorderThin solid $BackgroundColor;
}

AzQtComponents--TabBar::tab:selected,
AzQtComponents--TabBar::tab:hover
{
    background-color: $BackgroundColor;
}

AzQtComponents--TabBar:focus
{
    outline: none;
    border: none;
}

/* Secondary Style */

AzQtComponents--TabWidget.Secondary
{
    background-color: $BackgroundColor;
}

AzQtComponents--TabWidget.Secondary.Bordered
{
    border: $BorderThin solid $SeparatorColor;
}

AzQtComponents--TabWidget.Secondary:pane
{
    border: 0 none;
    border-top: $BorderDivider solid $TabWidgetSecondaryPaneBorderColor;
    padding: $SpacingTabSecondaryPanePad;
    padding-top: 0;
}

AzQtComponents--TabWidget.Secondary:tab-bar
{
    left: 1px;
    min-height: $SizeTabBarSecondaryHeight;
}

AzQtComponents--TabBar.Secondary
{
    border: 0 none;
}

AzQtComponents--TabBar.Secondary.Bordered
{
    border-left: $BorderThin solid $SeparatorColor;
    border-top: $BorderThin solid $SeparatorColor;
}

AzQtComponents--TabBar.Secondary::tab
{
    background-color: $BackgroundColor;
    border: 0 none;
    border-bottom: $BorderTabUnderline solid $TabWidgetInactiveTabColor;
    text-align: center;
    padding: $SpacingTabSecondaryPadding;
    color: $TabWidgetSecondaryTabTextColor;
}

AzQtComponents--TabBar.Secondary::close-button
{
    image: url(":/stylesheet/img/close_small.svg");
}

AzQtComponents--TabBar.Secondary::tab:hover
{
    background: $TabWidgetSecondaryHoverColor;
    border-bottom: $BorderTabUnderline solid $BackgroundColor;
    color: $PrimaryTextColor;
}

AzQtComponents--TabBar.Secondary.Bordered::tab
{
    border-top: $BorderThin solid $SeparatorColor;
    padding: $SpacingTabSecondaryBorderedPadding;
}

AzQtComponents--TabBar.Secondary::tab:selected
{
    border-bottom: $BorderTabUnderline solid $TabWidgetSecondarySelectedBorderColor;
    color: $PrimaryTextColor;
}
