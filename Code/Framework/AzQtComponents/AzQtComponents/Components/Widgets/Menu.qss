QMenu
{
    background-color: $MenuBackgroundColor;
}

QMenu::item
{
    color: $PrimaryTextColor;
    font-size: $FontSize;
    font-family: "$FontFamily";

    /* default height is 18px */
    /* target height is 24px */
    /* 24 - 18 = 6 */
    /* 6 / 2 = 3 */
    /* top, right, bottom, left */
    padding: $SpacingMenuItemTop auto $SpacingMenuItemBottom $SpacingMenuItemLeft;
    height: $SizeMenuItemHeight;
}

/* Hover */
QMenu::item:selected,
QMenu::item .WidgetAction:hover
{
    background-color: $MenuItemSelectedBackgroundColor;
}

QMenu::icon,
QMenu::right-arrow
{
    width: $SizeGlyph;
    height: $SizeGlyph;

    subcontrol-position: right center;
}

QMenu::right-arrow
{
    right: 4px;
}

QMenu::icon
{
    right: 20px;
}

QMenu::indicator:checked
{
    width: $SizeGlyph;
    height: $SizeGlyph;
    margin-left: $SpacingMenuIndicatorMarginLeft;
    image: url(:/stylesheet/img/UI20/checkmark-menu.svg);
}

QMenu::item:disabled
{
    color: $MenuItemDisabledColor;
}

QMenu::separator
{
    height: 0px;
    border-bottom: $BorderThin solid $MenuSeparatorColor;
    margin-top: $SpacingMenuSeparatorMarginTop;
    margin-bottom: $SpacingMenuSeparatorMarginBottom;
}

QMenu.SourceControlMenu
{
    margin-left: $SpacingSourceControlMenuMarginH;
    margin-right: $SpacingSourceControlMenuMarginH;
}

QMenu.SourceControlMenu::item
{
    margin-left: $SpacingSourceControlMenuItemMarginLeft;
}
