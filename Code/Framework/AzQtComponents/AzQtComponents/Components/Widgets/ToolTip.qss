QToolTip
{
    color: $PrimaryTextColor;
    background-color: $ToolTipBackgroundColor;
    border: 1px transparent black;
    margin-left: 2px;
    font-size: $FontSize;
    margin-top: 4px;
    margin-bottom: 4px;
    font-family: "$FontFamily";
}
