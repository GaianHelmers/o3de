QScrollBar
{
    border: 2px solid $ScrollBarBorderColor;
    background: none;
    margin: 0px;
}

QScrollBar:vertical
{
    width: 8px;
}

QScrollBar:horizontal
{
    height: 8px;
}

QScrollBar::handle
{
    border: 0px solid $ScrollBarHandleBorderColor;
    border-radius: 2px;
    background-color: $ScrollBarHandleColor;
}

QAbstractScrollArea.DarkScrollBar QScrollBar::handle
{
    border: 0px solid $ScrollBarHandleBorderColor;
    border-radius: 2px;
    background-color: $ScrollBarDarkHandleColor;
}

QScrollBar::handle:vertical {
    min-height: 32px;
}

QScrollBar::handle:horizontal {
    min-width: 32px;
}

QScrollBar::add-line,
QScrollBar::sub-line
{
     border: none;
     background: none;
     color: none;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal
{
     width: 0px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical
{
     height: 0px;
}

QAbstractScrollArea > .QWidget
{
    background: none;
}

/* scrollbar hovered */

QScrollBar:hover
{
    border: 1px solid $ScrollBarBorderColor;
    background: none;
    margin: 0px;
}

QAbstractScrollArea.DarkScrollBar QScrollBar:hover
{
    border: 1px solid $ScrollBarDarkHandleColor;
    background: none;
    margin: 0px;
}

QScrollBar::handle:hover
{
    border-radius: 3px;
    background-color: $ScrollBarHandleHoverColor;
}

QAbstractScrollArea > .QWidget:hover,
QAbstractScrollArea > .QWidget[ShowBackground=true]
{
    background-color: $ScrollBarTrackHoverColor;
}

QAbstractScrollArea.DarkScrollBar > .QWidget:hover,
QAbstractScrollArea.DarkScrollBar > .QWidget[ShowBackground=true]
{
    background-color: $ScrollBarDarkTrackHoverColor;
}
