QScrollBar
{
    border: $BorderDivider solid $ScrollBarBorderColor;
    background: none;
    margin: 0px;
}

QScrollBar:vertical
{
    width: $SizeScrollBarThickness;
}

QScrollBar:horizontal
{
    height: $SizeScrollBarThickness;
}

QScrollBar::handle
{
    border: 0px solid $ScrollBarHandleBorderColor;
    border-radius: $RadiusScrollHandle;
    background-color: $ScrollBarHandleColor;
}

QAbstractScrollArea.DarkScrollBar QScrollBar::handle
{
    border: 0px solid $ScrollBarHandleBorderColor;
    border-radius: $RadiusScrollHandle;
    background-color: $ScrollBarDarkHandleColor;
}

QScrollBar::handle:vertical {
    min-height: $SizeScrollHandleMin;
}

QScrollBar::handle:horizontal {
    min-width: $SizeScrollHandleMin;
}

QScrollBar::add-line,
QScrollBar::sub-line
{
     border: none;
     background: none;
     color: none;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal
{
     width: 0px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical
{
     height: 0px;
}

QAbstractScrollArea > .QWidget
{
    background: none;
}

/* scrollbar hovered */

QScrollBar:hover
{
    border: $BorderThin solid $ScrollBarBorderColor;
    background: none;
    margin: 0px;
}

QAbstractScrollArea.DarkScrollBar QScrollBar:hover
{
    border: $BorderThin solid $ScrollBarDarkHandleColor;
    background: none;
    margin: 0px;
}

QScrollBar::handle:hover
{
    border-radius: $RadiusScrollHandle;
    background-color: $ScrollBarHandleHoverColor;
}

QAbstractScrollArea > .QWidget:hover,
QAbstractScrollArea > .QWidget[ShowBackground=true]
{
    background-color: $ScrollBarTrackHoverColor;
}

QAbstractScrollArea.DarkScrollBar > .QWidget:hover,
QAbstractScrollArea.DarkScrollBar > .QWidget[ShowBackground=true]
{
    background-color: $ScrollBarDarkTrackHoverColor;
}
