ActionWidget #LinkButton
{
    qproperty-flat: true;
}

AzAssetBrowserWindow #previewWidgetWrapper
{
    background-color: $AssetBrowserPreviewBackgroundColor;
    border: 0 none;
}

AzAssetBrowserWindow #searchButtonContainer
{
    background-color: $AssetBrowserSearchBarBackgroundColor;
    border: 0 none;
}

AzAssetBrowserWindow #m_separator
{
    background-color: $MenuBackgroundColor;
}

/* Component Palette Widget */
AzToolsFramework--ComponentPaletteWidget
{
    border: 1px solid $ComponentPaletteWidgetBorderColor;
    background-color: $ComponentPaletteWidgetBackgroundColor;
}

AzToolsFramework--ComponentPaletteWidget > QTreeView
{
    background-color: $MenuBackgroundColor;
}

AzToolsFramework--PropertyRowWidget[canBeReordered="true"]  QLabel#Name
{
    font-weight: bold;
}

/* Style for visualizing property values overridden from their prefab values */
AzToolsFramework--PropertyRowWidget[IsOverridden=true] #Name QLabel,
AzToolsFramework--ComponentEditorHeader #Title[IsOverridden="true"]
{
    font-weight: bold;
    color: $OverrideHighlightColor;
}

/* Asset Editor: the tab body is wrapped in an AzQtComponents::Card (file name = card title,
   reflected data = card body), so the surfaces are driven by the shared Card tokens. The outer
   widget intentionally has NO background override, falling back to the global
   QWidget { $WidgetBackgroundColor } rule so the area behind the card matches the Entity
   Inspector's far background. The reflected property editor is transparent so the card body
   ($CardBackgroundColor) shows through it, mirroring the inspector's per-card property editors. */
#AssetEditorWidgetPropertyEditor
{
    background-color: transparent;
}

/* The asset file-tab strip gets a distinct "sub-bar" background so it reads as its own bar,
   separated from the editor's main tab bar above it, and so the card visibly floats on the
   lighter widget background below it. */
AzQtComponents--TabWidget#AssetEditorTabWidget AzQtComponents--TabBar.Secondary
{
    background-color: $SubBarBackgroundColor;
}

/* The asset scroll area / its contents carry the inspector far background. */
#AssetEditorScrollArea,
#AssetEditorScrollArea > QWidget
{
    background-color: $WidgetBackgroundColor;
}

#AssetEditorWidgetPropertyEditor AzToolsFramework--PropertyRowWidget[isTopLevel="true"]
{
    qproperty-appendDefaultLabelToName:1;
}

#AssetEditorWidgetPropertyEditor AzToolsFramework--PropertyRowWidget[isTopLevel="false"]
{
    qproperty-appendDefaultLabelToName:0;
}

#AssetEditorWidgetPropertyEditor AzToolsFramework--PropertyRowWidget[getLevel="1"][hasChildRows="true"]
, #AssetEditorWidgetPropertyEditor AzToolsFramework--DPERowWidget[getLevel="2"][hasChildRows="true"]
{
    border-top: 1px solid $PropertySectionDividerColor;
}

/* Set the Script Canvas search highlight color */
GraphCanvas--NodePaletteTreeView
{
    selection-background-color: $SelectionHighlightColor;
}

AzQtComponents--TabWidget#ScriptCanvasTabs
{
    height: 32px;
    margin: 0 2px;
    max-height: 32px;
}

/* Save Slice Override Window */
AzToolsFramework--SlicePushWidget QTreeView QLabel
{
    min-height: 14px;
}

AzToolsFramework--SlicePushWidget QWidget#WarningTopLine
{
    background-color: $OverrideHighlightColor
}

AzToolsFramework--SlicePushWidget QWidget#WarningBottomLine
{
    background-color: $SlicePushWarningBottomColor
}

AzToolsFramework--SlicePushWidget QTreeWidget#WarningTreeWidget::item:pressed
, AzToolsFramework--SlicePushWidget QTreeWidget#WarningTreeWidget::item:selected
{
    background-color: $SlicePushWarningTreeSelectedColor;
}

/* Toolbar borders (Editor UI Window) */
EditorWindow QToolBar
{
    border-bottom: 2px solid $SeparatorColor;
}

DockWidgetTitleBar #DockWidgetContextMenu
{
    qproperty-icon: url(:/Cards/img/UI20/Cards/menu_ico.svg);
    qproperty-iconSize: 24px 16px;
    qproperty-flat: true;
    margin: 0px;
    max-width: 24px;
    max-height: 16px;
}

#EMFX_Menu
{
    border-bottom-width: 2px;
    border-bottom-color: $SeparatorColor;
    border-bottom-style: solid;
}

#EMFX_Menu QComboBox
{
    margin-right: 4px;
    margin-bottom: 2px;
}

PanelTitleBar
{
    border-top: 1px solid $SeparatorColor;
}

/* Asset Editor */

#AssetEditorStatusBar
{
    border-top: 2px solid $SeparatorColor;
}

/* Editor bottom status bar (P4V / pending jobs / game folder indicator) */

MainStatusBar
{
    background-color: $StatusBarBackgroundColor;
    border-top: 1px solid $SeparatorColor;
}

MainStatusBar StatusBarItem
{
    background-color: transparent;
    color: $StatusBarTextColor;
}

/* Console and Python Console */

ConsoleTextEdit,
ConsoleTextEdit:hover,
ConsoleTextEdit:focus,
#SCRIPT_OUTPUT,
#SCRIPT_OUTPUT:hover,
#SCRIPT_OUTPUT:focus
{
    margin: 0;
    margin-top: 6px;
    background-color: $ConsoleBackgroundColor;
    border-radius: 0px;
    border-width: 0px;
    border-color: $InputBorderColor;
    border-style: solid;
}

/* Viewport title bar -- the viewport's own top bar (CViewportTitleDlg). Styled uniquely (it is not a
   pane title bar) via its own $ViewportTitleDlgBackgroundColor token. NOTE: the dead stylesheet's old
   #ViewportTitleDlgContainer objectName no longer exists; the live widget is the CViewportTitleDlg class. */
CViewportTitleDlg,
QWidget#ViewportTitleDlg,
CViewportTitleDlg > QWidget
{
    background-color: $ViewportTitleDlgBackgroundColor;
}

/* Asset Browser body + favourites bar -- otherwise fall back to the default grey. Covers all three view
   modes (tree / table / thumbnail) plus the favourites view, and the window background behind them. */
AzAssetBrowserWindow,
AzToolsFramework--AssetBrowser--AssetBrowserTreeView,
AzToolsFramework--AssetBrowser--AssetBrowserTableView,
AzToolsFramework--AssetBrowser--AssetBrowserThumbnailView,
AzToolsFramework--AssetBrowser--AssetBrowserFavoritesView
{
    background-color: $PanelBackgroundColor;
}

/* Asset Browser thumbnail (grid) view body -- its own token so the grid behind the tiles can be tuned
   independently. The tile boxes themselves are themed in C++ (AssetFolderThumbnailView loadConfig). */
AzQtComponents--AssetFolderThumbnailView,
AzQtComponents--AssetFolderThumbnailView > QWidget
{
    background-color: $AssetGridBackgroundColor;
}

/* Entity Inspector status block ("dark box"). The hardcoded rgb(51,51,51) inline stylesheet was removed
   from EntityPropertyEditor.ui so this themed rule can apply. */
QWidget#m_darkBox
{
    background-color: $DarkPanelBackgroundColor;
}

/* Inspector status-block fields (Name / Entity ID / Status) -- drop their individual field backgrounds
   so they pass through to the status block's colour (user request) instead of sitting as grey pills. */
QWidget#m_darkBox QLineEdit,
QWidget#m_darkBox QComboBox,
QWidget#m_darkBox QLabel,
QWidget#m_darkBox QFrame
{
    background-color: transparent;
}
